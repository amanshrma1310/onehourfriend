generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                      String                @id @default(cuid())
  username                String                @unique
  email                   String?               @unique
  passwordHash            String?
  avatar                  String                @default("🌙")
  bio                     String                @default("Here to have meaningful conversations.")
  activeRole              String                @default("PROBLEM_FACER") // PROBLEM_FACER, GUIDER, CASUAL_CHILL
  preferredIntent         String                @default("PEACE") // PEACE, GUIDANCE, CASUAL, SPARK
  preferredSocialGroup    String                @default("OPEN") // OPEN, BOYS, GIRLS, STUDENTS, NIGHT_OWLS, TECH
  mood                    String                @default("Need to vent")
  status                  String                @default("ONLINE") // ONLINE, OFFLINE, MATCHING, IN_CHAT
  trustScore              Float                 @default(5.0)
  karmaPoints             Int                   @default(100)
  totalSessionsAsGuider   Int                   @default(0)
  totalSessionsAsSeeker   Int                   @default(0)
  isAnonymous             Boolean               @default(true)
  isBanned                Boolean               @default(false)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  lastSeen                DateTime?             @default(now())

  // Relations
  blocksReceived          Block[]               @relation("BlocksReceived")
  blocksGiven             Block[]               @relation("BlocksGiven")
  sessionsAsUserOne       ConversationSession[] @relation("UserOneSessions")
  sessionsAsUserTwo       ConversationSession[] @relation("UserTwoSessions")
  messages                Message[]
  ratingsGiven            Rating[]              @relation("RatingsGiven")
  ratingsReceived         Rating[]              @relation("RatingsReceived")
  reportsReceived         Report[]              @relation("ReportsReceived")
  reportsMade             Report[]              @relation("ReportsMade")
  interests               UserInterest[]
  friendshipsAsUserOne    Friendship[]          @relation("FriendshipsOne")
  friendshipsAsUserTwo    Friendship[]          @relation("FriendshipsTwo")
  friendMessages          FriendMessage[]
  ventPosts               VentPost[]
  dailyAnswers            DailyAnswer[]
}

model Interest {
  id        String         @id @default(cuid())
  name      String         @unique
  createdAt DateTime       @default(now())
  users     UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([interestId])
}

model ConversationSession {
  id              String        @id @default(cuid())
  userOneId       String
  userTwoId       String
  roleOne         String        @default("PROBLEM_FACER")
  roleTwo         String        @default("GUIDER")
  intent          String        @default("PEACE")
  socialGroup     String        @default("OPEN")
  topic           String        @default("General")
  mood            String        @default("General")
  problemSummary  String?
  status          String        @default("ACTIVE")
  matchedAt       DateTime?     @default(now())
  startedAt       DateTime?     @default(now())
  expiresAt       DateTime?
  endedAt         DateTime?
  userOneKept     Boolean       @default(false)
  userTwoKept     Boolean       @default(false)
  isCompanion     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  userOne         User          @relation("UserOneSessions", fields: [userOneId], references: [id])
  userTwo         User          @relation("UserTwoSessions", fields: [userTwoId], references: [id])
  messages        Message[]
  ratings         Rating[]

  @@index([userOneId])
  @@index([userTwoId])
  @@index([status])
  @@index([expiresAt])
}

model Message {
  id        String              @id @default(cuid())
  sessionId String
  userId    String
  content   String
  type      String              @default("TEXT")
  createdAt DateTime            @default(now())
  session   ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId])
}

model Rating {
  id         String              @id @default(cuid())
  sessionId  String
  fromUserId String
  toUserId   String
  value      Int                 @default(5)
  badges     String?
  comment    String?
  createdAt  DateTime            @default(now())
  fromUser   User                @relation("RatingsGiven", fields: [fromUserId], references: [id])
  session    ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toUser     User                @relation("RatingsReceived", fields: [toUserId], references: [id])

  @@unique([sessionId, fromUserId])
  @@index([toUserId])
}

model Friendship {
  id        String          @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime        @default(now())
  userOne   User            @relation("FriendshipsOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User            @relation("FriendshipsTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages  FriendMessage[]

  @@unique([userOneId, userTwoId])
}

model FriendMessage {
  id           String     @id @default(cuid())
  friendshipId String
  senderId     String
  content      String
  createdAt    DateTime   @default(now())
  friendship   Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([friendshipId, createdAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String    @id @default(cuid())
  reporterId     String
  reportedUserId String
  reason         String
  description    String?
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?
  reportedUser   User      @relation("ReportsReceived", fields: [reportedUserId], references: [id])
  reporter       User      @relation("ReportsMade", fields: [reporterId], references: [id])

  @@index([reportedUserId])
  @@index([status])
}

model MatchQueue {
  id             String   @id @default(cuid())
  userId         String   @unique
  role           String   @default("PROBLEM_FACER")
  intent         String   @default("PEACE")
  socialGroup    String   @default("OPEN")
  mood           String   @default("General")
  problemSummary String?
  enteredAt      DateTime @default(now())

  @@index([role, intent, socialGroup])
}

model VentPost {
  id            String   @id @default(cuid())
  userId        String
  anonymousName String
  avatar        String   @default("🌙")
  content       String
  category      String   @default("Peace & Healing")
  mood          String   @default("Need to vent")
  hugsCount     Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model DailyQuestion {
  id           String        @id @default(cuid())
  question     String
  category     String        @default("Deep Thoughts")
  date         String        @unique
  totalAnswers Int           @default(0)
  createdAt    DateTime      @default(now())
  answers      DailyAnswer[]
}

model DailyAnswer {
  id            String        @id @default(cuid())
  questionId    String
  userId        String
  anonymousName String
  avatar        String        @default("✨")
  answer        String
  likesCount    Int           @default(0)
  createdAt     DateTime      @default(now())
  question      DailyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}
